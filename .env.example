# ---------- Core ----------
# SQLite for local dev. For production use PostgreSQL hosted in an Indian region
# (AWS ap-south-1 Mumbai / ap-south-2 Hyderabad, Azure Central India, GCP asia-south1)
# and change `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"

# ---------- Secrets (generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))") ----------
# AES-256-GCM key for contact details stored at rest. Losing it = losing those fields. Back it up in a secrets manager.
DATA_ENCRYPTION_KEY=""
# Pepper for HMAC blind indexes, OTP hashes, IP hashes. Changing it logs everyone out and breaks lookups.
HASH_PEPPER=""
# Bearer secret for /api/cron/* (call it from your scheduler)
CRON_SECRET=""

# ---------- OTP delivery ----------
# "console" prints the code in the server log (development only; refused in production)
SMS_PROVIDER="console"          # console | msg91
EMAIL_PROVIDER="console"        # console | smtp
# Set to 1 if you run behind a trusted reverse proxy that sets X-Forwarded-For (Vercel, Nginx, ALB)
TRUST_PROXY=""

# MSG91 (TRAI DLT-registered sender + template are mandatory for Indian SMS)
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""
# Hard ceiling on SMS OTPs per day across the whole app (protects against SMS-pumping fraud). 0 = no ceiling.
SMS_DAILY_CAP="2000"

# SMTP (AWS SES ap-south-1, Zoho, Postmark, ...)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Saathi <no-reply@example.com>"

# ---------- Social login (optional; a button appears only when both values are set) ----------
# Redirect URI to register: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Redirect URI to register: {APP_URL}/api/auth/facebook/callback
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ---------- Legal contacts shown on /privacy and /grievance (DPDP Act + IT Rules 2021) ----------
LEGAL_ENTITY_NAME="Your Company Pvt. Ltd."
LEGAL_ENTITY_ADDRESS="Registered office address, City, State, PIN"
GRIEVANCE_OFFICER_NAME="Name of Grievance Officer"
GRIEVANCE_OFFICER_EMAIL="grievance@example.com"
DPO_EMAIL="privacy@example.com"
